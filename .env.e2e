# Variables de las pruebas e2e (npm run test:e2e). Se commitea a propósito:
# no tiene ningún secreto real. La base es LOCAL (Docker o el servicio de
# Postgres del CI) y playwright.config.ts se niega a arrancar si no lo es.

DATABASE_URL="postgresql://postgres:postgres@localhost:5433/gimnasio_e2e"
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/gimnasio_e2e"

# Secreto que existe SOLO en las pruebas: con él e2e/sesiones.ts fabrica
# las cookies de sesión. No es el de producción y no sirve para nada más.
AUTH_SECRET="secreto-solo-para-pruebas-e2e-no-usar-en-produccion"
AUTH_TRUST_HOST="true"
AUTH_URL="http://localhost:3100"
AUTH_GOOGLE_ID="sin-google-en-pruebas"
AUTH_GOOGLE_SECRET="sin-google-en-pruebas"

# Vacías a propósito: el mail es accesorio y las pruebas verifican que la
# reserva se confirma igual sin él. Vacías (y no ausentes) para que Next.js
# no tome las del .env.local de quien corre las pruebas.
RESEND_API_KEY=""
CORREO_REMITENTE=""
