# Copiar a .env.local y completar. NUNCA commitear .env.local.

# Base de datos. Las dos strings salen del botón "Connect" del panel de Supabase.
#
# DATABASE_URL: pooler en modo Transaction (puerto 6543). Es la que usa la app.
DATABASE_URL="postgresql://usuario:password@host:6543/postgres?pgbouncer=true"
#
# DIRECT_URL: conexión directa (puerto 5432). Solo la usan las migraciones.
DIRECT_URL="postgresql://usuario:password@host:5432/postgres"

# Secreto de sesión. Generar con: npx auth secret
AUTH_SECRET=""

AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Correo de confirmación de reservas (Resend, docs/spec.md sección 8).
# La clave sale de resend.com → API Keys. Solo la lee lib/servicios/correo.ts.
# Sin estas dos variables la reserva se confirma igual y no sale el mail.
RESEND_API_KEY=""
# Con el dominio de prueba de Resend solo se puede mandar al mail de la cuenta.
CORREO_REMITENTE="Gimnasio <onboarding@resend.dev>"
# Opcional. Solo para la prueba de la clase 7 del servicio que tarda:
# CORREO_API_URL="https://10.255.255.1/emails"

# Regla: ninguna variable con un secreto puede llamarse NEXT_PUBLIC_*,
# porque todo lo que lleva ese prefijo queda visible en el navegador.
